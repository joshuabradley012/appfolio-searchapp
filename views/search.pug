extends layout

block content
  main.grid-x
    
    aside.show-for-large
      section.sidebar.grid-y

        form#addSubdomain.grid-x.grid-padding-x(
          action='/'
          method='post'
          autocomplete='off'
        )
          .input-group
            input.input-group-field(
              name='subdomain'
              type='text'
              placeholder='Add website'
            )
            button.button.input-group-button(
              type='submit'
              id='addSubdomain'
            ) Add

        a.refresh.text-right(
          id='refreshDatabase'
        ) Refresh database

        if (subdomains)

          ul.tracked-subdomains.unstyled

            each subdomain in subdomains

              li.subdomain.callout(data-closable)
                span= subdomain.url
                button(data-close, data=subdomain.url).close-button x

    article.cell.auto
      section.search-group.grid-x.grid-padding-y.grid-padding-x

        .cell.auto
          h1 Search listings...
          form#search(
            action='/'
            method='post'
            autocomplete='off'
          )

            - var previousSearch = ''
            if (search)
              - previousSearch = search

            .input-group
              input.input-group-field(
                name='search'
                type='text'
                value= previousSearch
              )
              button.button.input-group-button(
                type='submit'
                id='submitSearch'
              ) Search

            fieldset

              - var relevanceSorted = true
              - var leastSorted = false
              - var mostSorted = false
              if (sort)
                if (sort == 'relevance')
                  - relevanceSorted = true
                  - leastSorted = false
                  - mostSorted = false
                else if (sort == 'least')
                  - relevanceSorted = false
                  - leastSorted = true
                  - mostSorted = false
                else if (sort == 'most')
                  - relevanceSorted = false
                  - leastSorted = false
                  - mostSorted = true

              label.sort-label Sort by:
              input(
                type='radio'
                name='sort'
                value='relevance'
                id='sortRelevance'
                checked= relevanceSorted
              )
              label(for='sortRelevance') Relevance
              input(
                type='radio'
                name='sort'
                value='least'
                id='sortLeast'
                checked= leastSorted
              )
              label(for='sortLeast') Least expensive
              input(
                type='radio'
                name='sort'
                value='most'
                id='sortMost'
                checked= mostSorted
              )
              label(for='sortMost') Most expensive

      section.results

        if (listings)
          if (listings.length > 0)

            p.count !{listings.length} results
            ul.listings.unstyled.grid-x.grid-padding-x.grid-padding-y

              each listing in listings

                li.small-12.medium-6.cell
                  a(href=listing.url).listing.grid-x
                    .img-container.cell.small-12
                      img(src=listing.img)
                    .info.cell.auto
                      h3= listing.address
                      strong.rent= listing.rent
                      span.size= listing.size

                      if (search)
                        - search = search.replace(/"/gi, '');
                      - var preview = listing.text.match(new RegExp('([^\\s]*\\s+?){0,10}\\b' + search + '\\b((\\s+|.)?[^\\s]*){0,10}', 'gi'));
                      if (preview !== null)
                        - var previewText = preview[0].replace(new RegExp(search, 'gi'), '<strong>$&</strong>');

                        p ...!{previewText}...

                      else

                        p No preview available.

          else if (listings.length === 0)

            h2 No results found for: #{search}  
        
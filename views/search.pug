extends layout

block content
  div(class='grid-x grid-padding-x align-center')
    div(class='small-8 cell') 
      form(
        action='/'
        method='post'
        id='appfolio-search'
        class='form login-system'
        autocomplete='off'
      )
        div(class='form-item search')
          label Search
          input(
            name='search'
            class='form-input'
            type='text'
            placeholder='section 8'
          )
        div(class='form-item subdomains')
          label Subdomains
          input(
            name='subdomains'
            class='form-input'
            type='text'
            placeholder='solarentals, rayrobertsrealty, ...'
          )
        div(class='form-item submit')
          button(
            id='submit-btn'
            class='button'
            type='submit'
          r) Search


extends layout

block content
  .grid-y.grid-frame.align-center
    .grid-x.grid-padding-x.grid-margin-y.align-center
      .small-8.medium-6.large-5.cell
        img(src='/images/appfolio-logo.png')
      .medium-10.large-8.cell
        form#search.input-group(
          action='/'
          method='post'
          autocomplete='off'
        )
          input.input-group-field(
            name='search'
            type='text'
            placeholder='Search ...'
          )
          button.button.input-group-button(
            type='submit'
          ) Search
      .medium-10.large-8.cell
        form#subdomains.grid-x.grid-padding-x(
          action='add-subdomain'
          method='post'
          autocomplete='off'
        )
          .medium-6.cell
            label Subdomains being tracked
              .input-group
                input.input-group-field(
                  name='subdomains'
                  type='text'
                  placeholder='https://solrentals.appfiolio.com'
                )
                button.button.input-group-button(
                  type='submit'
                ) Search